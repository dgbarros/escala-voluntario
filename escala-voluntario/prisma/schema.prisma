datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Church {
  id                 String         @id @default(uuid())
  name               String
  cnpj               String         @unique
  status             String         @default("active") // active, inactive
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  users              User[]
  userRoles          UserRole[]
  departments        Department[]
  inviteTokens       InviteToken[]

  @@map("churches")
}

model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  passwordHash String     @map("password_hash")
  churchId     String     @map("church_id")
  profileImage String?    @map("profile_image")
  bio          String?
  createdAt    DateTime   @default(now()) @map("created_at")

  church       Church     @relation(fields: [churchId], references: [id], onDelete: Cascade)
  userRoles    UserRole[]
  
  // Relacionamentos com departamentos (como líder ou criador de agendas)
  ledDepartments Department[] @relation("DepartmentLeader")
  schedules      Schedule[]

  @@map("users")
}

model Role {
  id          String     @id @default(uuid())
  name        String     @unique // super_admin, admin, leader, volunteer
  description String?
  userRoles   UserRole[]

  @@map("roles")
}

// Tabela do "Grupo de WhatsApp" e da "Fila de Espera"
model UserRole {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  roleId     String   @map("role_id")
  churchId   String   @map("church_id")
  departmentId String?  @map("department_id") // Vincula o voluntário ao departamento dele
  approved   Boolean  @default(false) // Se false -> Cai na aba de "Solicitações" do Admin
  createdAt  DateTime @default(now()) @map("created_at")

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  church     Church      @relation(fields: [churchId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@map("user_roles")
}

model Department {
  id        String   @id @default(uuid())
  name      String
  churchId  String   @map("church_id")
  leaderId  String?  @map("leader_id") // O Admin clica e define o User ID aqui (Estilo Admin do Whats)

  church    Church     @relation(fields: [churchId], references: [id], onDelete: Cascade)
  leader    User?      @relation("DepartmentLeader", fields: [leaderId], references: [id], onDelete: SetNull)
  userRoles UserRole[]
  schedules Schedule[]
  inviteTokens InviteToken[]

  @@map("departments")
}

// Tabela que controla os links de cadastro enviados pelo Admin
model InviteToken {
  id           String   @id @default(uuid())
  token        String   @unique @default(uuid()) // O código secreto que vai na URL
  churchId     String   @map("church_id")
  departmentId String   @map("department_id")
  used         Boolean  @default(false) // Fica true quando o voluntário usa o link
  createdAt    DateTime @default(now()) @map("created_at")
  expiresAt    DateTime @map("expires_at") // O link pode expirar em 7 dias, por exemplo

  church     Church     @relation(fields: [churchId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@map("invite_tokens")
}

model Schedule {
  id           String     @id @default(uuid())
  departmentId String     @map("department_id")
  date         DateTime   @db.Date
  time         String
  createdBy    String     @map("created_by")

  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  creator      User       @relation(fields: [createdBy], references: [id])

  @@map("schedules")
}